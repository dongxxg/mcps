# serverOps secrets file — the SINGLE source for every password / key / URL.
#
# Loaded into the environment before config interpolation, so the ${VAR}
# references in servers.yaml (DB URLs) and `password_env` (SSH) pick them up.
# Existing shell / .mcp.json env vars are NEVER overridden — the file only
# fills in what is missing.
#
# Copy to `.env` (git-ignored) and fill in real values. Never commit real secrets.
# Quotes optional: WEB1_SSH_PASSWORD="p@ss" == WEB1_SSH_PASSWORD=p@ss

# --- Secrets referenced from servers.yaml ---
# DB URL referenced as `url: "${ANALYTICS_DB_URL}"`:
# ANALYTICS_DB_URL=postgresql+asyncpg://user:password@db.host:5432/analytics
# Redis URL referenced as `url: "${REDIS_URL}"`:
# REDIS_URL=redis://:secret@cache.host:6379/0
# ClickHouse URL referenced as `url: "${CLICKHOUSE_URL}"` (query-only):
# CLICKHOUSE_URL=clickhouse://default:@ch.host:8123/analytics
# CLICKHOUSE_URL=clickhouse+https://default:secret@ch.host:8443/analytics
# SSH password referenced via `password_env: WEB1_SSH_PASSWORD`:
# WEB1_SSH_PASSWORD=

# --- Where this file is (optional) ---
# By default serverOps finds `.env` next to servers.yaml, one dir above it,
# or at ~/.serverops/.env. To point elsewhere, set SERVEROPS_SECRETS (in the
# launcher / .mcp.json / shell) to an absolute path:
# SERVEROPS_SECRETS=/absolute/path/to/.env

# --- Optional server tuning (also readable from here) ---
# SERVEROPS_TRANSPORT=stdio            # or http
# SERVEROPS_HOST=127.0.0.1
# SERVEROPS_PORT=8000
# SERVEROPS_HTTP_TOKEN=replace-with-a-long-random-secret   # protect HTTP transport
